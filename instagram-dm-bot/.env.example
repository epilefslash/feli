# Token secreto que vos inventás (cualquier string) — lo usás al configurar el webhook en Meta
VERIFY_TOKEN=mi_token_secreto_123

# App Secret — está en Meta Developer Console > Tu App > Configuración > Básica
APP_SECRET=abc123...

# Page Access Token (largo plazo) — generalo en Meta Developer Console > Herramientas > Graph API Explorer
# Seleccioná tu página, pedí el token, luego convertilo a largo plazo
PAGE_TOKEN=EAAxxxxx...

# Palabras que disparan el DM (separadas por coma, sin distinguir mayúsculas)
TRIGGER_WORDS=mas info,más info,info,quiero info,precio,clases
